{
  "name": "alan-accountability",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run check-env && npm run check-lock && npm run lint && npm run typecheck && npm test && npm run build",
    "deploy": "bash scripts/deploy.sh",
    "start": "next start",
    "lint": "next lint",
    "prepare": "git config core.hooksPath .githooks || true",
    "check-env": "node scripts/check-env.mjs",
    "check-lock": "npm ci --dry-run",
    "verify:quick": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@upstash/redis": "^1.34.0",
    "@upstash/vector": "^1.2.3",
    "next": "14.2.5",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.5",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "20.20.2",
    "npm": "10.8.2"
  }
}
